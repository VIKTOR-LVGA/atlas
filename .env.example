# Example local / development env (never real secrets)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_OR_LOCAL.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=  # preferred server-side key; local only, never commit
SUPABASE_SERVICE_ROLE_KEY=  # legacy fallback; local only, never commit

OPENAI_API_KEY=
OPENAI_POLICY_EXTRACTION_MODEL=gpt-5.2
OPENAI_POLICY_EXTRACTION_MODEL_STRONG=gpt-5.2
# Optional request limits in milliseconds (bounded to 5s–180s by the app)
OPENAI_POLICY_EXTRACTION_TIMEOUT_MS=90000
OPENAI_ASK_ATLAS_TIMEOUT_MS=20000

NEXT_PUBLIC_ATLAS_SUPPORT_EMAIL=support@example.com

# Optional
CRON_SECRET=
ATLAS_INTELLIGENCE_MIN_COHORT_SIZE=20
ATLAS_FLAG_BENCHMARK_SAVINGS=0

# Broker Workspace hibernation (default OFF). Set true to re-enable public Broker portal.
# Data-layer gate (RLS): also requires DB flag via set_broker_portal_enabled(true).
ENABLE_BROKER_PORTAL=false
# Equivalent: ATLAS_FLAG_BROKER_PORTAL=0
